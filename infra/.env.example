# Copy this to infra/.env and fill in. infra/.env is gitignored (never commit real secrets).
# These values feed docker-compose variable substitution.

# --- Shared JWT secret: every service must agree on this so tokens validate everywhere ---
JWT_SECRET=change-me-in-prod
DEMO_PASSWORD=consmat123

# --- Hub LLM (procurement intelligence) ---
# Set AI_PROVIDER=gemini and paste a Google AI Studio key into AI_API_KEY to go live.
# Leave AI_PROVIDER=stub (or the key blank) to run deterministic-only.
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest
AI_BASE_URL=

# --- Payment gateway secrets (only needed if services/payment-service/config.yaml selects a real provider) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYU_KEY=
PAYU_SALT=
CASHFREE_APP_ID=
CASHFREE_SECRET=
